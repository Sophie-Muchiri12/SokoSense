# ── Database: Postgres + pgvector ───────────────────────────────────────────
# LOCAL DEV (default below): start the Docker Postgres in docker-compose.yml
#   docker compose up -d db
# and leave this URL as-is — registration/login and the knowledge base run
# against your machine. (Market prices do NOT live here — see below.)
DATABASE_URL=postgresql://sokosense:sokosense_dev@localhost:5434/sokosense
#
# PRODUCTION (Render → Supabase): override DATABASE_URL in the Render
# dashboard with the Supabase transaction-pooler string (port 6543):
#   Supabase Dashboard → Project Settings → Database → Connection string
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# User accounts live in Postgres, so DATABASE_URL must be set (local Docker
# or Supabase) — without it register/login respond 503.

# Market prices: default source is this CSV, built from KAMIS by
# scripts/collect_market_data.py or the admin portal's refresh button.
MARKET_CSV_PATH=data/market_prices.csv
# When true, price/market decisions and the agent price tool fetch from the
# live KAMIS portal (https://kamis.kilimo.go.ke) first, with a short cache,
# and fall back to MARKET_CSV_PATH if the portal is unreachable.
USE_LIVE=false

# ── LLMs ────────────────────────────────────────────────────────────────────
# Groq LLM (agent + advisory RAG)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=

# ── Africa's Talking (SMS/USSD) ─────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=sandbox
AT_SMS_SHORTCODE=

# ── Deployment ──────────────────────────────────────────────────────────────
# Render sets PORT automatically; 8000 is the local default.
PORT=8000
PUBLIC_BASE_URL=

# Frontend (frontend/.env — Vite dev server at http://localhost:5173)
# Leave empty locally to proxy /api → backend via Vite. On Vercel set this
# to the Render backend URL, e.g. https://sokosense-api.onrender.com
VITE_API_URL=

# ── Auth ───────────────────────────────────────────────────────────────────
# AUTH_SECRET signs login sessions (JWTs). Generate one: openssl rand -hex 32
AUTH_SECRET=
# 7-digit PIN for the admin portal (footer → Admin → /admin-login).
ADMIN_PIN=
