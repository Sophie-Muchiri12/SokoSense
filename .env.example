# Featherless LLM (SMS parser — Sophie / Job)
FEATHERLSS_API_KEY=your_featherless_api_key_here
LLM_MODEL_FEATHERLESS=MiniMaxAI/MiniMax-M3

# Tavily search fallback (Job's KAMIS agent)
TAVILY_API_KEY=your_tavily_api_key_here

# Neo4j AuraDB (Lucy)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=your_aura_instance_name

# Africa's Talking (Lucy)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SMS_SHORTCODE=

# Deployment (Sophie)
PORT=8000
PUBLIC_BASE_URL=

# Frontend (Vite dev server — UI at http://localhost:8081)
# Leave empty to proxy /api → backend via Vite
VITE_API_URL=
